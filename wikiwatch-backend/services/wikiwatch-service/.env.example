# For commands on the host. Compose overrides the DB host to db:5432.
WIKIWATCH_DATABASE_URL=postgresql+asyncpg://wikiwatch:local-only-password@localhost:5433/wikiwatch
WIKIWATCH_CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]
WIKIWATCH_BOOTSTRAP_EMAIL=noor@wikiwatch.com
WIKIWATCH_BOOTSTRAP_PASSWORD=wikiwatch@123
WIKIWATCH_SEED_ON_DEPLOY=true
WIKIWATCH_SEED_DEMO=true
